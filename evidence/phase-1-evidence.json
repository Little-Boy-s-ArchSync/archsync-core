      {
        "file": "test/fixtures/minimal-evolution.architecture.yaml",
        "components": 3,
        "relationships": 2
      },
      {
        "file": "test/fixtures/minimal.architecture.yaml",
        "components": 2,
        "relationships": 1
      },
      {
        "file": "test/fixtures/order-platform.architecture.yaml",
        "components": 5,
        "relationships": 5
      }
    ],
    "expected_invalid": [
      {
        "file": "test/fixtures/invalid-schema.architecture.yaml",
        "issues": [
          {
            "path": "/version",
            "keyword": "schema",
            "message": "must match pattern \"^0\\.1(?:\\.[0-9]+)?$\""
          },
          {
            "path": "/components",
            "keyword": "schema",
            "message": "must match pattern \"^[a-z][a-z0-9-]*$\""
          },
          {
            "path": "/components",
            "keyword": "schema",
            "message": "property name must be valid"
          },
          {
            "path": "/components/Bad_Component_ID/type",
            "keyword": "schema",
            "message": "must be equal to one of the allowed values"
          },
          {
            "path": "/components/Bad_Component_ID/layer",
            "keyword": "schema",
            "message": "must be equal to one of the allowed values"
          },
          {
            "path": "/relationships",
            "keyword": "schema",
            "message": "must be array"
          }
        ]
      },
      {
        "file": "test/fixtures/invalid-unknown-component.architecture.yaml",
        "issues": [
          {
            "path": "/relationships/0/to",
            "keyword": "reference",
            "message": "Unknown component 'missing-database'"
          }
        ]
      }
    ]
  },
